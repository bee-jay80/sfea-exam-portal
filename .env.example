SECRET_KEY=replace-with-a-long-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL example values; fill in later)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=sfea_exam_portal
DB_USER=sfea_user
DB_PASSWORD=replace-with-your-db-password
DB_HOST=localhost
DB_PORT=5432

# JWT
JWT_SECRET_KEY=replace-with-a-separate-jwt-secret

# Email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email-user
EMAIL_HOST_PASSWORD=your-email-password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=no-reply@example.com

# Redis + Celery (fill in later)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Code execution service
CODE_EXECUTION_URL=http://localhost:8001
CODE_EXECUTION_API_KEY=replace-with-execution-service-key


PostgreSQL (production example)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=your_database
DB_USER=your_username
DB_PASSWORD=your_password
DB_HOST=your_database_host
DB_PORT=5432
DB_SSLMODE=require


# Timezone
TIME_ZONE=Africa/Lagos
